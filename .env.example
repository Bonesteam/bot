# Скопіюйте цей файл в .env та впишіть свої дані
# Ніколи не викладайте .env у публічні репозиторії (додайте у .gitignore)

BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# true = торгуємо на Binance Futures Testnet (віртуальні кошти, безпечно для тестів)
# false = торгуємо реальними коштами (вмикати тільки після повного тестування!)
BINANCE_TESTNET=true

# Пара та таймфрейм за замовчуванням (використовується run_backtest.py, find_setup.py)
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Список монет для моніторингу (monitor.py). Через кому, без пробілів навколо коми.
# Якщо залишити порожнім - моніторитиметься лише SYMBOL вище.
# Обирайте ліквідні пари - на них SMC-патерни "чистіші" (менше випадкового шуму).
WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT,LTC/USDT

# Telegram (додамо на наступному етапі)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Автоторгівля та ризик-менеджмент ---
# false = бот тільки надсилає сигнали в Telegram (безпечно)
# true = бот САМ відкриває угоди на testnet (переконайтесь, що готові до цього)
AUTO_TRADE_ENABLED=false

# Ризик на одну угоду (0.01 = 1% балансу)
RISK_PER_TRADE_PCT=0.01

# Плече для ф'ючерсів (низьке = безпечніше)
LEVERAGE=3

# Захисні ліміти
MAX_TRADES_PER_DAY=3
MAX_DAILY_LOSS_PCT=3.0

# КРИТИЧНО ВАЖЛИВО: щоб автоторгівля запрацювала на РЕАЛЬНОМУ акаунті
# (BINANCE_TESTNET=false), потрібно ЯВНО встановити це в true.
# Це навмисний запобіжник проти випадкового зливу реальних грошей.
LIVE_TRADING_CONFIRMED=false
